# Copy to .env.local for local development. Set the same keys in Vercel for production.

# --- Frontend (Vite) ---
VITE_API_URL=/api
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FORMSPREE_CONTACT_ID=
VITE_FORMSPREE_TESTIMONIALS_ID=
VITE_FORMSPREE_NEWSLETTER_ID=

# --- Serverless API (Vercel) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
DOWNLOAD_TOKEN_SECRET=
INTERNAL_API_SECRET=
PLUGIN_FILE_URL=
NOTIPRESS_PLUGIN_FILE_URL=
ALLOWED_ORIGINS=https://shalconnects.com,https://www.shalconnects.com,https://store.shalconnects.com

# Optional: Vercel KV for premium download stats
KV_REST_API_URL=
KV_REST_API_TOKEN=
